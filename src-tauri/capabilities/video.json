{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "video",
  "description": "Capability for the per-project Video editor windows",
  "windows": ["video-*"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-set-size",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "dialog:default"
  ]
}
