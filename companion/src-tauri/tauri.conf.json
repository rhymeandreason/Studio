{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Studio Claude",
  "version": "0.1.0",
  "identifier": "com.studio.claude",
  "build": {
    "frontendDist": "../../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "url": "claude/index.html",
        "title": "Claude",
        "width": 600,
        "height": 800,
        "minWidth": 420,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["studio-claude"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../../src-tauri/icons/32x32.png",
      "../../src-tauri/icons/128x128.png",
      "../../src-tauri/icons/128x128@2x.png",
      "../../src-tauri/icons/icon.icns",
      "../../src-tauri/icons/icon.ico"
    ]
  }
}
